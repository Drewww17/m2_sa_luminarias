rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserDoc(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid));
    }

    function role() {
      return hasUserDoc(request.auth.uid) ? userDoc(request.auth.uid).data.role : null;
    }

    function isAdmin() {
      return role() == "admin";
    }

    // FIX: Safely check for approvalStatus using .get()
    // If the field is missing (like in your simulated login), it defaults to 'approved' so you can test.
    function isDoctorApproved() {
      return role() == "doctor"
        && userDoc(request.auth.uid).data.get('approvalStatus', 'approved') == "approved";
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin(); // FIX: Allows users to update their own profile
      allow delete: if isAdmin();
    }

    match /scans/{scanId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update: if signedIn();

      allow delete: if isAdmin();
    }

    match /reportVerifications/{scanId} {
      allow read: if true;
      allow write: if isAdmin() || isDoctorApproved();
    }

    match /auditLogs/{logId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}